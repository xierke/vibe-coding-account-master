# DailyTracker 环境变量
# 复制此文件为 .env 并修改配置

# 应用
APP_NAME=DailyTracker
DEBUG=false

# 数据库 — MySQL（请修改为实际数据库连接信息）
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/account

# Redis（请修改为实际 Redis 连接信息）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT — 生产环境请更换为随机字符串 (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — 前端开发服务器地址
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 日志级别
LOG_LEVEL=INFO
